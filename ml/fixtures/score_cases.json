{
  "_comment": "Shared Python <-> TypeScript cases for the LLM song scores (TODO 2.29). Synthetic titles only.",
  "messages": [
    {
      "name": "one line per song, artists joined, control characters become a space",
      "songs": [
        {
          "title": "Slow Morning",
          "artists": [
            "Ana Example"
          ]
        },
        {
          "title": "Tab\there\r\nand newline",
          "artists": [
            "First",
            "Second"
          ]
        },
        {
          "title": "Été « fête » 夜",
          "artists": [
            "Ünïcode Band"
          ]
        }
      ],
      "expected": "0\tSlow Morning\tAna Example\n1\tTab here and newline\tFirst, Second\n2\tÉté « fête » 夜\tÜnïcode Band"
    }
  ],
  "parses": [
    {
      "name": "valid",
      "count": 3,
      "text": "{\"s\":[{\"i\":0,\"e\":20,\"p\":30},{\"i\":1,\"e\":100,\"p\":0},{\"i\":2,\"e\":55,\"p\":50}]}",
      "expected": [
        {
          "energy": 0.2,
          "positivity": 0.3
        },
        {
          "energy": 1.0,
          "positivity": 0.0
        },
        {
          "energy": 0.55,
          "positivity": 0.5
        }
      ]
    },
    {
      "name": "any order",
      "count": 2,
      "text": "{\"s\":[{\"i\":1,\"e\":10,\"p\":20},{\"i\":0,\"e\":30,\"p\":40}]}",
      "expected": [
        {
          "energy": 0.3,
          "positivity": 0.4
        },
        {
          "energy": 0.1,
          "positivity": 0.2
        }
      ]
    },
    {
      "name": "missing index",
      "count": 3,
      "text": "{\"s\":[{\"i\":0,\"e\":20,\"p\":30},{\"i\":2,\"e\":55,\"p\":50}]}",
      "expected": [
        {
          "energy": 0.2,
          "positivity": 0.3
        },
        null,
        {
          "energy": 0.55,
          "positivity": 0.5
        }
      ]
    },
    {
      "name": "duplicate index",
      "count": 2,
      "text": "{\"s\":[{\"i\":0,\"e\":20,\"p\":30},{\"i\":0,\"e\":25,\"p\":35},{\"i\":1,\"e\":40,\"p\":40}]}",
      "expected": [
        null,
        {
          "energy": 0.4,
          "positivity": 0.4
        }
      ]
    },
    {
      "name": "out of range or not an integer",
      "count": 3,
      "text": "{\"s\":[{\"i\":0,\"e\":101,\"p\":30},{\"i\":1,\"e\":-1,\"p\":30},{\"i\":2,\"e\":50.5,\"p\":30}]}",
      "expected": [
        null,
        null,
        null
      ]
    },
    {
      "name": "missing or extra key and unknown index",
      "count": 2,
      "text": "{\"s\":[{\"i\":0,\"e\":20},{\"i\":1,\"e\":20,\"p\":30,\"x\":1},{\"i\":2,\"e\":20,\"p\":30},{\"i\":-1,\"e\":5,\"p\":5}]}",
      "expected": [
        null,
        null
      ]
    },
    {
      "name": "pairs or triples instead of objects",
      "count": 2,
      "text": "{\"s\":[[20,30],[1,40,50]]}",
      "expected": [
        null,
        null
      ]
    },
    {
      "name": "boolean is not an integer",
      "count": 2,
      "text": "{\"s\":[{\"i\":0,\"e\":true,\"p\":30},{\"i\":true,\"e\":20,\"p\":30}]}",
      "expected": [
        null,
        null
      ]
    },
    {
      "name": "not JSON",
      "count": 2,
      "text": "Sure! Here are the scores",
      "expected": [
        null,
        null
      ]
    },
    {
      "name": "no s list",
      "count": 1,
      "text": "{\"scores\":[{\"i\":0,\"e\":20,\"p\":30}]}",
      "expected": [
        null
      ]
    }
  ]
}
